#Descarga de archivos del proyecto de metagenomica de suelo PRJNA385596 del siguiente enlace: https://www.ebi.ac.uk/ena/browser/view/PRJNA385596

#Preparación de entorno y muestras

  conda create -n tfm_metagenomica - c conda-forge -bioconda fastqc multiqc fastp
  conda activate tfm_metagenomica
mkdir -p TFM_metagenomica/data/{raw_fastq,trimmed_fastq} TFM_metagenomica/results/{fastqc_raw,fastqc_trimmed,multiqc_raw,multiqc_trimmed,fastp} TFM_metagenomica/{metadata,scripts}

#descargué los archivos de la web y los moví de descargas a la carpeta creada.
  cp ~/Downloads/SRR5626781_1.fastq ~/Downloads/SRR5626781_2.fastq ~/Downloads/SRR5626785_1.fastq ~/Downloads/SRR5626785_2.fastq data/raw_fastq/

# Una vez los archivos estan listos en el directorio, pasamos el  control de calidad

  fastqc data/raw_fastq/*.fastq -o results/fastqc_raw

  multiqc results/fastqc_raw -o results/multiqc_raw

